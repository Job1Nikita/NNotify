# Copy this file to /etc/nnotify/nnotify-auth.env
# chmod 640 /etc/nnotify/nnotify-auth.env
# chown root:nnotifysvc /etc/nnotify/nnotify-auth.env

HOST=127.0.0.1
PORT=3100
TRUST_PROXY=true
PUBLIC_BASE_URL=https://nnotify.example.com

DATABASE_PATH=/opt/nnotify/server/data/nnotify_auth.db

JWT_ACCESS_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET_64_PLUS_CHARS
REFRESH_TOKEN_PEPPER=CHANGE_ME_TO_DIFFERENT_LONG_RANDOM_SECRET_64_PLUS_CHARS
JWT_ISSUER=nnotify-auth
JWT_AUDIENCE=nnotify-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10
SESSION_CLEANUP_INTERVAL_MINUTES=15
SESSION_REVOKED_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180
TELEGRAM_CALLBACK_RETENTION_DAYS=30
REJECTED_USER_RETENTION_DAYS=3

PASSWORD_MIN_LENGTH=10
ALLOW_CLIENT_REGISTRATION=true
BOOTSTRAP_ADMIN_NAME=server-admin

TELEGRAM_MODERATION_ENABLED=false
TELEGRAM_BOT_TOKEN=CHANGE_ME
REMINDER_TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_ADMIN_CHAT_ID=CHANGE_ME
TELEGRAM_ADMIN_USER_IDS=123456789
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_TO_LONG_RANDOM_TOKEN
TELEGRAM_WEBHOOK_HEADER_SECRET=CHANGE_ME_TO_LONG_RANDOM_TOKEN_2
