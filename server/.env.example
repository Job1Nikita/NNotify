# ===== Network =====
# Keep local bind; expose only via nginx reverse proxy.
HOST=127.0.0.1
PORT=3100
TRUST_PROXY=true
PUBLIC_BASE_URL=https://nnotify.example.com

# ===== Database =====
DATABASE_PATH=./data/nnotify_auth.db

# ===== JWT / Session Security =====
# CHANGE THESE TO STRONG RANDOM VALUES (>= 64 chars)
JWT_ACCESS_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET_64_PLUS_CHARS
REFRESH_TOKEN_PEPPER=CHANGE_ME_TO_DIFFERENT_LONG_RANDOM_SECRET_64_PLUS_CHARS
JWT_ISSUER=nnotify-auth
JWT_AUDIENCE=nnotify-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10
SESSION_CLEANUP_INTERVAL_MINUTES=15
SESSION_REVOKED_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180
TELEGRAM_CALLBACK_RETENTION_DAYS=30
REJECTED_USER_RETENTION_DAYS=3

# ===== Password Policy =====
PASSWORD_MIN_LENGTH=10

# ===== Registration flow =====
# If true: client registration is allowed (with pending approval).
# If false: only admin CLI can create users.
ALLOW_CLIENT_REGISTRATION=true

# ===== Initial bootstrap admin (optional) =====
# Username of server operator shown in audit logs for approvals from CLI.
BOOTSTRAP_ADMIN_NAME=server-admin

# ===== Telegram moderation (optional, but recommended) =====
TELEGRAM_MODERATION_ENABLED=false
# CHANGE THESE IF ENABLED
TELEGRAM_BOT_TOKEN=CHANGE_ME
# Optional separate bot used for reminder escalation messages.
REMINDER_TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_ADMIN_CHAT_ID=CHANGE_ME
# Comma-separated Telegram user IDs allowed to approve/reject from buttons.
TELEGRAM_ADMIN_USER_IDS=123456789
# Secret in webhook path: /v1/telegram/webhook/<secret>
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_TO_LONG_RANDOM_TOKEN
# Telegram setWebhook secret_token / X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_HEADER_SECRET=CHANGE_ME_TO_LONG_RANDOM_TOKEN_2

