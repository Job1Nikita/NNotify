{
  "name": "nnotify-sync-server",
  "version": "2.0.0",
  "private": true,
  "description": "NNotify auth and reminder sync server",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "migrate": "tsx src/cli.ts migrate",
    "admin": "tsx src/cli.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "jose": "^5.9.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
