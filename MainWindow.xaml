<Window x:Class="NNotify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NNotify.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NNotify"
        Height="940"
        Width="1345"
        MinHeight="900"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="EmptyFocusVisualStyle" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}" />
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="MainSurfaceBrush" Color="#172235" />
        <SolidColorBrush x:Key="MainSurfaceSoftBrush" Color="#132033" />
        <SolidColorBrush x:Key="MainSurfaceRaisedBrush" Color="#1A273C" />
        <SolidColorBrush x:Key="MainBorderStrongBrush" Color="#2D4160" />
        <SolidColorBrush x:Key="MainDividerBrush" Color="#253A56" />
        <SolidColorBrush x:Key="MainMutedTextBrush" Color="#8FA3C2" />
        <SolidColorBrush x:Key="ActiveAccentBrush" Color="#38A8FF" />
        <SolidColorBrush x:Key="MissedAccentBrush" Color="#FF5A67" />
        <SolidColorBrush x:Key="TodayAccentBrush" Color="#9A6BFF" />
        <SolidColorBrush x:Key="HistoryAccentBrush" Color="#24D0B8" />
        <SolidColorBrush x:Key="WarningAccentBrush" Color="#FF7B55" />
        <SolidColorBrush x:Key="PositiveAccentBrush" Color="#39D08A" />

        <LinearGradientBrush x:Key="MainPrimaryButtonBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#27B6FF" Offset="0" />
            <GradientStop Color="#2F73FF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MainPrimaryButtonHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#35C0FF" Offset="0" />
            <GradientStop Color="#4585FF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ActionBlueButtonBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#45A6FF" Offset="0" />
            <GradientStop Color="#2F74EC" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ActionBlueButtonHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#53B1FF" Offset="0" />
            <GradientStop Color="#3A7EF3" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ActionBlueButtonPressedBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2D93F7" Offset="0" />
            <GradientStop Color="#2A66DC" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Effect" Value="{StaticResource PanelShadow}" />
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource ModernCardStyle}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="17" />
        </Style>

        <Style x:Key="IconBoxBaseStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="SectionIconBoxStyle" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Padding" Value="15,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyFocusVisualStyle}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="142" />
            <Setter Property="Background" Value="#3E85F5" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#F4FAFF" />
            <Setter Property="TextElement.Foreground" Value="#F4FAFF" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                TextElement.Foreground="#F4FAFF">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#4A90FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3478E3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="142" />
            <Setter Property="Background" Value="#3E85F5" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#F4FAFF" />
            <Setter Property="TextElement.Foreground" Value="#F4FAFF" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                TextElement.Foreground="#F4FAFF">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#4A90FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3478E3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderSwitchStyle" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyFocusVisualStyle}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="38" Height="22">
                            <Border x:Name="Track"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11" />
                            <Border x:Name="Thumb"
                                    Width="16"
                                    Height="16"
                                    CornerRadius="8"
                                    Background="{DynamicResource SecondaryTextBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="3,0,3,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SummaryTileStyle" TargetType="Border" BasedOn="{StaticResource ModernCardStyle}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>

        <Style x:Key="InsightChipLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="InsightChipValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="13.5" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,-1,0,0" />
        </Style>

        <Style x:Key="InsightChipCountBadgeStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="29" />
            <Setter Property="Height" Value="21" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="CornerRadius" Value="10.5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="#102D3B4F" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashboardListViewStyle" TargetType="ListView">
            <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyFocusVisualStyle}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListView}">
                        <ScrollViewer Focusable="False"
                                      Padding="0"
                                      Style="{DynamicResource ListViewScrollViewerStyle}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardTableHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="DashboardTableCellTextStyle" TargetType="TextBlock">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="DashboardListItemStyle" TargetType="ListViewItem">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyFocusVisualStyle}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ListRowBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid x:Name="RowRoot" Background="Transparent" SnapsToDevicePixels="True">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="Transparent" />
                            <Border x:Name="SelectionSurface"
                                    Margin="4,3"
                                    CornerRadius="10"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    Opacity="0" />
                            <ContentPresenter Margin="0"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionSurface" Property="Background" Value="{DynamicResource ListRowHoverBrush}" />
                                <Setter TargetName="SelectionSurface" Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
                                <Setter TargetName="SelectionSurface" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionSurface" Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                                <Setter TargetName="SelectionSurface" Property="BorderBrush" Value="{DynamicResource SelectedRowBorderBrush}" />
                                <Setter TargetName="SelectionSurface" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="SelectionSurface" Property="Opacity" Value="1" />
                                <Setter TargetName="SelectionSurface" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.14" Color="#1B2D47" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SelectionSurface" Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RowRoot" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyFocusVisualStyle}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid Height="39" Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="HeaderBorder"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper"
                                   Width="4"
                                   HorizontalAlignment="Right"
                                   Cursor="SizeWE"
                                   Margin="0,0,-2,0"
                                   Opacity="0"
                                   Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource ListHeaderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="Role" Value="Padding">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="Transparent" />
                                <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DueDateCellTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="{Binding EffectiveDueLocal, StringFormat={}{0:yyyy-MM-dd}}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding EffectiveDueLocal, StringFormat={}{0:HH:mm}}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HistoryDateCellTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="{Binding HistoryMomentLocal, StringFormat={}{0:yyyy-MM-dd}}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding HistoryMomentLocal, StringFormat={}{0:HH:mm}}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PriorityBadgeTemplate">
            <Border MinWidth="68"
                    Height="22"
                    Padding="10,0"
                    CornerRadius="7"
                    HorizontalAlignment="Left"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource PriorityP1BadgeBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Priority}" Value="0">
                                <Setter Property="Background" Value="{DynamicResource PriorityP0BadgeBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Priority}" Value="2">
                                <Setter Property="Background" Value="{DynamicResource PriorityP2BadgeBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding PriorityLabel}" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource ActiveAccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Priority}" Value="0">
                                    <Setter Property="Foreground" Value="{StaticResource MissedAccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Priority}" Value="2">
                                    <Setter Property="Foreground" Value="{StaticResource PositiveAccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StatusBadgeTemplate">
            <Border MinWidth="118"
                    Height="22"
                    Padding="9,0"
                    CornerRadius="7"
                    HorizontalAlignment="Left"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource StatusDefaultBadgeBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="acked">
                                <Setter Property="Background" Value="{DynamicResource StatusAckBadgeBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="missed">
                                <Setter Property="Background" Value="{DynamicResource StatusMissedBadgeBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="fired">
                                <Setter Property="Background" Value="{DynamicResource StatusFiredBadgeBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE787;"
                               FontSize="11"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource ActiveAccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="acked">
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Setter Property="Foreground" Value="{StaticResource PositiveAccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                        <Setter Property="Text" Value="&#xE711;" />
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="missed">
                                        <Setter Property="Text" Value="&#xE823;" />
                                        <Setter Property="Foreground" Value="{StaticResource WarningAccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="fired">
                                        <Setter Property="Text" Value="&#xE7ED;" />
                                        <Setter Property="Foreground" Value="{StaticResource MissedAccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="snoozed">
                                        <Setter Property="Text" Value="&#xE916;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource ActiveAccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="acked">
                                        <Setter Property="Foreground" Value="{StaticResource PositiveAccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="missed">
                                        <Setter Property="Foreground" Value="{StaticResource WarningAccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="fired">
                                        <Setter Property="Foreground" Value="{StaticResource MissedAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReminderTitleCellTemplate">
            <TextBlock Focusable="False"
                       Text="{Binding Title}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"
                       MaxHeight="34"
                       FontWeight="SemiBold"
                       FontSize="12.5"
                       LineHeight="16"
                       VerticalAlignment="Center" />
        </DataTemplate>

