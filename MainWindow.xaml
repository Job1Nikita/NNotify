                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="{DynamicResource ListHeaderBackgroundBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0">
                                        <Grid Margin="8,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="118" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc MainColumnDue}" Style="{StaticResource DashboardTableHeaderTextStyle}" Margin="24,0,0,0" />
                                            <TextBlock Grid.Column="1" Text="{loc:Loc MainColumnPriority}" Style="{StaticResource DashboardTableHeaderTextStyle}" />
                                            <TextBlock Grid.Column="2" Text="{loc:Loc MainColumnText}" Style="{StaticResource DashboardTableHeaderTextStyle}" />
                                        </Grid>
                                    </Border>

                                    <ListView x:Name="MissedListView"
                                              Grid.Row="1"
                                              Style="{StaticResource DashboardListViewStyle}"
                                              ItemContainerStyle="{StaticResource DashboardListItemStyle}"
                                              ItemTemplate="{StaticResource MissedRowTemplate}">
                                        <ListView.ContextMenu>
                                            <ContextMenu Style="{StaticResource AppContextMenuStyle}">
                                                <MenuItem Header="{loc:Loc CommonDelete}" Style="{StaticResource AppMenuItemStyle}" Click="OnMissedContextDeleteClick" />
                                            </ContextMenu>
                                        </ListView.ContextMenu>
                                    </ListView>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>

                    <Border x:Name="InsightsCard" Grid.Row="1" Style="{StaticResource SectionCardStyle}" Margin="0,10,0,0" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <Border Style="{StaticResource SectionIconBoxStyle}" Width="30" Height="30" Background="#249A6BFF">
                                    <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M3,5 V19 H21"
                                                  Stroke="{StaticResource TodayAccentBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                            <Path Data="M5,16 L9,12 L13,14 L18,8 L21,10"
                                                  Stroke="{StaticResource TodayAccentBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="{loc:Loc MainOverviewInsightsTitle}" FontSize="14.5" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <UniformGrid Columns="4" Rows="2">
                                <Border CornerRadius="10" Padding="7,5" Margin="0,0,6,6" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Loc MainOverviewAll}" Foreground="{DynamicResource SecondaryTextBrush}" Style="{StaticResource InsightChipLabelTextStyle}" Margin="0,0,8,0" />
                                        <Border Grid.Column="1" Style="{StaticResource InsightChipCountBadgeStyle}" Background="#102D3B4F">
                                            <TextBlock x:Name="TotalCountText" Text="0" Style="{StaticResource InsightChipValueTextStyle}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="10" Padding="7,5" Margin="0,0,6,6" Background="#1A38A8FF" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Loc MainOverviewActive}" Style="{StaticResource InsightChipLabelTextStyle}" Margin="0,0,8,0" />
                                        <Border Grid.Column="1" Style="{StaticResource InsightChipCountBadgeStyle}" Background="#2438A8FF">
                                            <TextBlock x:Name="ActiveInsightCountText" Text="0" Foreground="{StaticResource ActiveAccentBrush}" Style="{StaticResource InsightChipValueTextStyle}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="10" Padding="7,5" Margin="0,0,6,6" Background="#1AFF5A67" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Loc MainOverviewMissed}" Style="{StaticResource InsightChipLabelTextStyle}" Margin="0,0,8,0" />
                                        <Border Grid.Column="1" Style="{StaticResource InsightChipCountBadgeStyle}" Background="#24FF5A67">
                                            <TextBlock x:Name="MissedInsightCountText" Text="0" Foreground="{StaticResource MissedAccentBrush}" Style="{StaticResource InsightChipValueTextStyle}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="10" Padding="7,5" Margin="0,0,0,6" Background="#1A9A6BFF" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Loc MainOverviewToday}" Style="{StaticResource InsightChipLabelTextStyle}" Margin="0,0,8,0" />
                                        <Border Grid.Column="1" Style="{StaticResource InsightChipCountBadgeStyle}" Background="#229A6BFF">
                                            <TextBlock x:Name="TodayInsightCountText" Text="0" Foreground="{StaticResource TodayAccentBrush}" Style="{StaticResource InsightChipValueTextStyle}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="10" Padding="7,5" Margin="0,0,6,0" Background="#1AFF5A67" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Loc PriorityHigh}" Style="{StaticResource InsightChipLabelTextStyle}" Margin="0,0,8,0" />
                                        <Border Grid.Column="1" Style="{StaticResource InsightChipCountBadgeStyle}" Background="#24FF5A67">
                                            <TextBlock x:Name="HighPriorityCountText" Text="0" Foreground="{StaticResource MissedAccentBrush}" Style="{StaticResource InsightChipValueTextStyle}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="10" Padding="7,5" Margin="0,0,6,0" Background="#1A38A8FF" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Loc PriorityMedium}" Style="{StaticResource InsightChipLabelTextStyle}" Margin="0,0,8,0" />
                                        <Border Grid.Column="1" Style="{StaticResource InsightChipCountBadgeStyle}" Background="#2438A8FF">
                                            <TextBlock x:Name="MediumPriorityCountText" Text="0" Foreground="{StaticResource ActiveAccentBrush}" Style="{StaticResource InsightChipValueTextStyle}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="10" Padding="7,5" Margin="0,0,6,0" Background="#1A39D08A" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Loc PriorityLow}" Style="{StaticResource InsightChipLabelTextStyle}" Margin="0,0,8,0" />
                                        <Border Grid.Column="1" Style="{StaticResource InsightChipCountBadgeStyle}" Background="#2439D08A">
                                            <TextBlock x:Name="LowPriorityCountText" Text="0" Foreground="{StaticResource PositiveAccentBrush}" Style="{StaticResource InsightChipValueTextStyle}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="10" Padding="7,5" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Loc MainOverviewNoPriority}" Foreground="{DynamicResource SecondaryTextBrush}" Style="{StaticResource InsightChipLabelTextStyle}" Margin="0,0,8,0" />
                                        <Border Grid.Column="1" Style="{StaticResource InsightChipCountBadgeStyle}" Background="#102D3B4F">
                                            <TextBlock x:Name="NoPriorityCountText" Text="0" Style="{StaticResource InsightChipValueTextStyle}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border x:Name="HistoryCard" Grid.Row="4" Style="{StaticResource SectionCardStyle}" Margin="0,10,0,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource SectionIconBoxStyle}" Background="#2224D0B8">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource HistoryAccentBrush}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{loc:Loc MainHistoryTitle}" FontSize="15" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc MainHistorySubtitle}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="14,2,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource PanelBackgroundBrush}">
                        <Grid Margin="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="31" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource ListHeaderBackgroundBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0">
                                <Grid Margin="8,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="36" />
                                        <!-- Reserve space used by the ListView vertical scrollbar.
                                             Without this gutter the headers after the flexible text column
                                             drift to the right while the row content is measured inside
                                             the scrolled viewport. -->
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc MainColumnWhen}" Style="{StaticResource DashboardTableHeaderTextStyle}" Margin="26,0,0,0" />
                                    <TextBlock Grid.Column="1" Text="{loc:Loc MainColumnPriority}" Style="{StaticResource DashboardTableHeaderTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{loc:Loc MainColumnText}" Style="{StaticResource DashboardTableHeaderTextStyle}" />
                                    <Grid Grid.Column="3" Width="118" HorizontalAlignment="Left">
                                        <TextBlock Text="{loc:Loc MainColumnResult}"
                                                   Style="{StaticResource DashboardTableHeaderTextStyle}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Column="4" Text="{loc:Loc MainColumnEscalation}" Style="{StaticResource DashboardTableHeaderTextStyle}" />
                                </Grid>
                            </Border>

                            <ListView x:Name="HistoryListView"
                                      Grid.Row="1"
                                      Style="{StaticResource DashboardListViewStyle}"
                                      ItemContainerStyle="{StaticResource DashboardListItemStyle}"
                                      ItemTemplate="{StaticResource HistoryRowTemplate}">
                                <ListView.ContextMenu>
                                    <ContextMenu Style="{StaticResource AppContextMenuStyle}">
                                        <MenuItem Header="{loc:Loc MainMenuRepeat}" Style="{StaticResource AppMenuItemStyle}" Click="OnHistoryContextRepeatClick" />
                                        <MenuItem Header="{loc:Loc CommonDelete}" Style="{StaticResource AppMenuItemStyle}" Click="OnHistoryContextDeleteClick" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <Border x:Name="FooterCard" Grid.Row="5" Style="{StaticResource ModernCardStyle}" Margin="0,12,0,0" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource ActiveAccentBrush}" VerticalAlignment="Center" Margin="2,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="{loc:Loc MainQuickActionsTitle}" FontSize="15" FontWeight="Bold" />
                            <TextBlock x:Name="HotKeyHintText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel x:Name="UpcomingActionsPanel" Orientation="Horizontal" Visibility="Collapsed">
                            <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Click="OnAckClick">
                                <TextBlock Text="{loc:Loc ActionAck}" Foreground="#F4FAFF" />
                            </Button>
                            <Button Content="{loc:Loc ActionSnooze5}" Style="{StaticResource FooterActionButtonStyle}" Click="OnSnooze5Click" />
                            <Button Content="{loc:Loc ActionSnooze15}" Style="{StaticResource FooterActionButtonStyle}" Click="OnSnooze15Click" />
                            <Button Content="{loc:Loc ActionEdit}" Style="{StaticResource FooterActionButtonStyle}" Click="OnEditClick" />
                            <Button Content="{loc:Loc CommonDelete}" Style="{StaticResource FooterActionButtonStyle}" Click="OnDeleteClick" ToolTip="{loc:Loc MainDeleteTooltip}" />
                        </StackPanel>

                        <StackPanel x:Name="DeleteOnlyActionsPanel" Orientation="Horizontal" Visibility="Collapsed">
                            <Button Content="{loc:Loc CommonDelete}" Style="{StaticResource FooterActionButtonStyle}" Click="OnDeleteClick" ToolTip="{loc:Loc MainDeleteTooltip}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="MainModalBackdrop"
                Panel.ZIndex="50"
                Background="{DynamicResource ModalBackdropBrush}"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="True" />
    </Grid>
</Window>





