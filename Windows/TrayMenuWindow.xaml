<Window x:Class="NNotify.Windows.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NNotify.Localization"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="EmptyFocusVisualStyle" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vector icons instead of font glyphs: crisp on any DPI and theme. -->
        <Geometry x:Key="TrayOpenIconGeometry">M3,4 H11.8 V5.45 H4.45 V12.55 H11.55 V10.4 H13 V14 H3 Z M8.25,2 H15 V8.75 H13.55 V4.48 L7.05,10.98 L6.02,9.95 L12.52,3.45 H8.25 Z</Geometry>
        <Geometry x:Key="TrayAddIconGeometry">M7.25,2 H8.75 V7.25 H14 V8.75 H8.75 V14 H7.25 V8.75 H2 V7.25 H7.25 Z</Geometry>
        <Geometry x:Key="TrayExitIconGeometry">M2,2 H9 V3.45 H3.45 V12.55 H9 V14 H2 Z M9.55,5.25 L10.58,4.22 L14.36,8 L10.58,11.78 L9.55,10.75 L11.55,8.75 H6.5 V7.25 H11.55 Z</Geometry>

        <Style x:Key="TrayMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="IconBack"
                                        Grid.Column="0"
                                        Width="22"
                                        Height="22"
                                        CornerRadius="7"
                                        Background="{DynamicResource HoverBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Viewbox Width="13"
                                             Height="13"
                                             Stretch="Uniform"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <Path x:Name="IconPath"
                                              Data="{StaticResource TrayOpenIconGeometry}"
                                              Fill="{DynamicResource AccentBrush}" />
                                    </Viewbox>
                                </Border>

                                <ContentPresenter Grid.Column="1"
                                                  Margin="2,0,0,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="add">
                                <Setter TargetName="IconPath" Property="Data" Value="{StaticResource TrayAddIconGeometry}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="exit">
                                <Setter TargetName="IconPath" Property="Data" Value="{StaticResource TrayExitIconGeometry}" />
                                <Setter TargetName="IconPath" Property="Fill" Value="#E04A59" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                                <Setter TargetName="Root" Property="Opacity" Value="0.94" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Width="256"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrushLight}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="12"
            SnapsToDevicePixels="True">
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="NNotify"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,1" />
                    <TextBlock Text="{loc:Loc TrayQuickActions}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Width="8"
                        Height="8"
                        CornerRadius="4"
                        Background="{DynamicResource AccentBrush}"
                        Opacity="0.72"
                        VerticalAlignment="Top"
                        Margin="0,4,2,0" />
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource BorderBrushLight}" Opacity="0.75" Margin="0,0,0,7" />

            <Button x:Name="OpenButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Content="{loc:Loc TrayOpen}"
                    Click="OnOpenClick" />
            <Button Style="{StaticResource TrayMenuButtonStyle}"
                    Tag="add"
                    Content="{loc:Loc TrayAddReminder}"
                    Click="OnAddClick" />
            <Button Style="{StaticResource TrayMenuButtonStyle}"
                    Tag="exit"
                    Content="{loc:Loc TrayExit}"
                    Click="OnExitClick" />
        </StackPanel>
    </Border>
</Window>
