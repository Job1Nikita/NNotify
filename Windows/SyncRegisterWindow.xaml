<Window x:Class="NNotify.Windows.SyncRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NNotify.Localization"
        Title="{loc:Loc SyncRegisterWindowTitle}"
        Height="492"
        Width="588"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        Opacity="0">
    <Window.Resources>
        <Style x:Key="EmptyFocusVisualStyle" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedInputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedInputPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="DialogSurface"
          Background="Transparent"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="DialogScale" ScaleX="0.985" ScaleY="0.985" />
                <TranslateTransform x:Name="DialogTranslate" Y="10" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Border Style="{StaticResource PanelCardStyle}" Margin="0" Padding="0" Effect="{x:Null}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,10,12,6" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource AccentGradientBrush}" ClipToBounds="True" VerticalAlignment="Center">
                            <Grid>
                                <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White" Data="M4,20 V4 H8 L16,12 V4 H20 V20 H16 L8,12 V20 Z" />
                                    </Canvas>
                                </Viewbox>
                                <Ellipse Width="4"
                                         Height="4"
                                         Fill="#8EEBFF"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,3,3,0" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{loc:Loc SyncRegisterWindowTitle}" Margin="8,0,0,0" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            Content="&#xE8BB;"
                            Click="OnCloseButtonClick" />
                </Grid>

                <Grid Grid.Row="1" Margin="14,8,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{loc:Loc SyncRegisterHeading}"
                               FontSize="31"
                               FontWeight="Bold"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Text="{loc:Loc SyncRegisterLabelServer}" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBox x:Name="ServerTextBox"
                             Grid.Row="2"
                             Height="38"
                             Margin="0,6,0,0"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource RoundedInputTextBoxStyle}" />
                    <TextBlock Grid.Row="3"
                               Text="{loc:Loc SyncRegisterHintServerExample}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4" Text="{loc:Loc SyncRegisterLabelUsername}" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBox x:Name="UsernameTextBox"
                             Grid.Row="5"
                             Height="38"
                             Margin="0,6,0,0"
                             VerticalContentAlignment="Center"
                             MaxLength="64"
                             Style="{StaticResource RoundedInputTextBoxStyle}" />
                    <TextBlock Grid.Row="6"
                               Text="{loc:Loc SyncRegisterHintUsernameExample}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="7" Text="{loc:Loc SyncRegisterLabelPassword}" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <StackPanel Grid.Row="8" Margin="0,6,0,0">
                        <PasswordBox x:Name="PasswordInput"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     MaxLength="256"
                                     Style="{StaticResource RoundedInputPasswordBoxStyle}" />
                        <TextBlock Text="{loc:Loc SyncRegisterHintPasswordRules}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusText"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="10"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">
                        <Button x:Name="CancelButton"
                                Content="{loc:Loc CommonCancel}"
                                Width="106"
                                IsCancel="True" />
                        <Button x:Name="SubmitButton"
                                Width="178"
                                IsDefault="True"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnSubmitClick">
                            <TextBlock Text="{loc:Loc SyncRegisterButtonSubmit}" Foreground="#F4FAFF" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
